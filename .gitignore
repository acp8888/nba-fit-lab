# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# uv
.uv/

# Data — S3 is source of truth; never commit raw or processed data
# Ignore raw hand-exports under data/local, but TRACK hand-curated, public,
# source-cited manual data (transactions, roster overrides) — small & version-worthy.
# (Exclude contents, not the dir, so data/local/manual/ can be re-included.)
data/local/*
!data/local/manual/

# Charts — only commit final post-ready assets explicitly
charts/

# Credentials and environment
.env
.env.*
*.pem
*.key

# marimo run-session cache (auto-generated notebook state)
notebooks/__marimo__/

# macOS
.DS_Store

# IDEs
.idea/
.vscode/
*.swp
